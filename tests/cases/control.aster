fn even(n: i64) -> bool {
    if n == 0 {
        return true;
    }
    return odd(n - 1);
}

fn odd(n: i64) -> bool {
    if n == 0 {
        return false;
    }
    return even(n - 1);
}

fn main() -> i64 {
    var i: i64 = 0;
    var total: i64 = 0;
    while i < 10 {
        i = i + 1;
        if i == 5 {
            continue;
        }
        if i == 9 {
            break;
        }
        total = total + i;
    }
    println_int(total);
    println_int(even(18) as i64);
    var x: i64 = 0;
    while x < 3 && total > 0 {
        var j: i64 = 0;
        while j < 2 {
            total = total - 1;
            j = j + 1;
        }
        x = x + 1;
    }
    println_int(total);
    return 0;
}
