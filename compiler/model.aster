import std.collections;
// All compiler algorithms are Aster. Shared arrays let compilation contexts be
// passed by value while their explicitly owned tables remain mutable.
struct Token {
    text: str, kind: i64, pos: i64, file: i64,
}
struct Node {
    tag: str, text: str, ty: str, a: i64, b: i64, c: i64, kids: []i64, tok: i64,
}
struct Function {
    name: str, module: str, names: []str, types: []str, ret: str, body: i64, tok: i64,
}
struct Record {
    name: str, names: []str, types: []str, tok: i64,
}
struct Import {
    owner: i64, alias: str, module: str,
}
struct State {
    tokens: []Token, nodes: []Node, functions: []Function, records: []Record, imports: []Import, paths: []str,
    sources: []str, modules: []str, cursor: []i64, root: str, symbols: StringMap,
}
struct Inst {
    op: str, ty: str, a: i64, b: i64, args: []i64, labels: []i64, text: str, block: i64, repl: i64, dead: bool,
}
struct Block {
    code: []i64, preds: []i64, defs: []i64, pending: []i64, sealed: bool, term: str, values: []i64, targets: []i64,
    alive: bool,
}
struct Variable {
    name: str, ty: str, writable: bool, depth: i64,
}
struct IR {
    s: State, fid: i64, ins: []Inst, blocks: []Block, vars: []Variable, active: []i64, current: []i64,
    depth: []i64, breaks: []i64, continues: []i64,
}
struct Value {
    id: i64, ty: str,
}
struct Lens {
    kind: str, ty: str, base: i64, index: i64, field: i64,
}

fn byte(s: str, i: i64) -> i64 {
    return s[i] as i64;
}

fn starts(s: str, prefix: str) -> bool {
    return len(s) >= len(prefix) && slice(s, 0, len(prefix)) == prefix;
}

fn ends(s: str, suffix: str) -> bool {
    return len(s) >= len(suffix) && slice(s, len(s) - len(suffix), len(suffix)) == suffix;
}

fn has(xs: []i64, x: i64) -> bool {
    var i: i64 = 0;
    while i < len(xs) {
        if xs[i] == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn find(xs: []str, x: str) -> i64 {
    var i: i64 = 0;
    while i < len(xs) {
        if xs[i] == x {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

fn copy_ids(xs: []i64) -> []i64 {
    var r: []i64 = [];
    var i: i64 = 0;
    while i < len(xs) {
        push(r, xs[i]);
        i = i + 1;
    }
    return r;
}

fn new_state(root: str) -> State {
    return State {
        tokens: [], nodes: [], functions: [], records: [], imports: [], paths: [], sources: [], modules: [],
        cursor: [0], root: root, symbols: map_new(),
    };
}

fn error(s: State, tok: i64, message: str) -> void {
    let t: Token = s.tokens[tok];
    let src: str = s.sources[t.file];
    var line: i64 = 1;
    var col: i64 = 1;
    var begin: i64 = 0;
    var i: i64 = 0;
    while i < t.pos {
        if byte(src, i) == 10 {
            line = line + 1;
            col = 1;
            begin = i + 1;
        } else {
            col = col + 1;
        }
        i = i + 1;
    }
    var stop: i64 = t.pos;
    while stop < len(src) && byte(src, stop) != 10 {
        stop = stop + 1;
    }
    eprint(s.paths[t.file] + ":" + itoa(line) + ":" + itoa(col) + ": error: " + message + "\n");
    eprint(slice(src, begin, stop - begin) + "\n");
    var spaces: []str = [];
    i = 1;
    while i < col {
        push(spaces, " ");
        i = i + 1;
    }
    eprint(join(spaces, "") + "^\n");
    exit(1);
}

fn node(s: State, tag: str, text: str, ty: str, a: i64, b: i64, c: i64, kids: []i64, tok: i64) -> i64 {
    let n: i64 = len(s.nodes);
    push(s.nodes, Node {
        tag: tag, text: text, ty: ty, a: a, b: b, c: c, kids: kids, tok: tok,
    });
    return n;
}

fn peek(s: State) -> str {
    if s.tokens[s.cursor[0]].kind == 3 {
        return "<string>";
    }
    return s.tokens[s.cursor[0]].text;
}

fn take(s: State) -> str {
    let t: str = s.tokens[s.cursor[0]].text;
    s.cursor[0] = s.cursor[0] + 1;
    return t;
}

fn eat(s: State, t: str) -> bool {
    if peek(s) == t {
        s.cursor[0] = s.cursor[0] + 1;
        return true;
    }
    return false;
}

fn need(s: State, t: str) -> void {
    if ! eat(s, t) {
        error(s, s.cursor[0], "expected '" + t + "', got '" + peek(s) + "'");
    }
}

fn name(s: State) -> str {
    if s.tokens[s.cursor[0]].kind != 1 {
        error(s, s.cursor[0], "expected identifier");
    }
    return take(s);
}

fn qualified(s: State) -> str {
    var n: str = name(s);
    while eat(s, "::") {
        n = n + "::" + name(s);
    }
    return n;
}

fn parse_type(s: State) -> str {
    if eat(s, "[") {
        need(s, "]");
        return "[]" + parse_type(s);
    }
    return qualified(s);
}

fn record_id(s: State, n: str) -> i64 {
    var i: i64 = 0;
    while i < len(s.records) {
        if s.records[i].name == n {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

fn element(t: str) -> str {
    return slice(t, 2, len(t) - 2);
}

fn is_integer(t: str) -> bool {
    return t == "i64" || t == "u8";
}

fn known_type(s: State, t: str) -> bool {
    if starts(t, "[]") {
        return element(t) != "void" && known_type(s, element(t));
    }
    return t == "i64" || t == "u8" || t == "str" || t == "bool" || t == "void" || record_id(s, t) >= 0;
}
