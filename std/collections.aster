// Deterministic open-addressed map. Storage is Aster arrays; hashes, probing,
// load-factor control and rehashing are all implemented in Aster.
struct StringMap {
    keys: []str, values: []i64, used: []i64, count: []i64,
}

fn map_new() -> StringMap {
    let m: StringMap = StringMap {
        keys: [], values: [], used: [], count: [0],
    };
    var i: i64 = 0;
    while i < 16 {
        push(m.keys, "");
        push(m.values, - 1);
        push(m.used, 0);
        i = i + 1;
    }
    return m;
}

fn map_hash(key: str) -> i64 {
    var h: i64 = 1469598103934665603;
    var i: i64 = 0;
    while i < len(key) {
        h =(h ^(key[i] as i64)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn map_get(m: StringMap, key: str) -> i64 {
    var slot: i64 = map_hash(key) &(len(m.keys) - 1);
    while m.used[slot] != 0 {
        if m.keys[slot] == key {
            return m.values[slot];
        }
        slot =(slot + 1) &(len(m.keys) - 1);
    }
    return - 1;
}

fn map_put(m: StringMap, key: str, value: i64) -> void {
    if(m.count[0] + 1) * 3 > len(m.keys) * 2 {
        var i: i64 = 0;
        var keys: []str = [];
        var values: []i64 = [];
        while i < len(m.keys) {
            if m.used[i] != 0 {
                push(keys, m.keys[i]);
                push(values, m.values[i]);
            }
            i = i + 1;
        }
        let cap: i64 = len(m.keys) * 2;
        i = 0;
        while i < len(m.keys) {
            m.keys[i] = "";
            m.values[i] = - 1;
            m.used[i] = 0;
            i = i + 1;
        }
        while i < cap {
            push(m.keys, "");
            push(m.values, - 1);
            push(m.used, 0);
            i = i + 1;
        }
        m.count[0] = 0;
        i = 0;
        while i < len(keys) {
            map_put(m, keys[i], values[i]);
            i = i + 1;
        }
    }
    var slot: i64 = map_hash(key) &(len(m.keys) - 1);
    while m.used[slot] != 0 && m.keys[slot] != key {
        slot =(slot + 1) &(len(m.keys) - 1);
    }
    if m.used[slot] == 0 {
        m.count[0] = m.count[0] + 1;
    }
    m.used[slot] = 1;
    m.keys[slot] = key;
    m.values[slot] = value;
}
